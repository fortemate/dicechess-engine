#!/usr/bin/env bash
#MISE description="📦 Prepare the distribution folder for the npm wasm package"
#MISE depends=["wasm:build"]

set -euo pipefail

# Determine the version.
#
# CI passes it explicitly via PACKAGE_VERSION, because it already knows it — release.yaml
# from its version bump and the tag-based publishing workflows from the tag name. Scraping it back out of
# sbt there was pure risk for no gain, and it cost two releases: the output shape depends
# on session state (an unscoped `print version` prints one line *per project* once
# `set ThisBuild / version := ...` has run) and, in CI, on which stream sbt writes to.
#
# The sbt query stays as a fallback so `mise run package:prepare` still works locally with
# no arguments. `|| true` keeps the pipeline alive so the check below can report properly
# instead of `pipefail` killing the script silently.
VERSION="${PACKAGE_VERSION:-}"
if [[ -z "$VERSION" ]]; then
  SBT_OUT=$(sbt -no-colors --error 'print rootJVM/version' 2>&1 || true)
  VERSION=$(printf '%s' "$SBT_OUT" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+(-SNAPSHOT)?' | head -n 1 || true)
fi
if [[ -z "$VERSION" ]]; then
  echo "error: could not determine the project version" >&2
  echo "       set PACKAGE_VERSION, or make 'print rootJVM/version' return a semver." >&2
  echo "       raw sbt output was:" >&2
  printf '%s\n' "${SBT_OUT:-<sbt was not queried>}" | sed 's/^/         /' >&2
  exit 1
fi
# Normalise: tag-based workflows pass the tag name (vX.Y.Z), release.yaml passes a bare
# version, and the sbt fallback yields X.Y.Z-SNAPSHOT. npm accepts none of the prefixed or
# suffixed forms, so strip both here rather than relying on every caller to do it.
CLEAN_VERSION="${VERSION#v}"
CLEAN_VERSION="${CLEAN_VERSION%-SNAPSHOT}"
if [[ ! "$CLEAN_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "error: '$VERSION' does not normalise to a semver version (got '$CLEAN_VERSION')" >&2
  exit 1
fi

# Create distribution directory
rm -rf -- dist-wasm
mkdir -p dist-wasm

# Sync version in a temporary package.json
cp package.json dist-wasm/package.json
sed -i.bak "s/\"version\": \"[^\"]*\"/\"version\": \"$CLEAN_VERSION\"/" dist-wasm/package.json
sed -i.bak "s/\"name\": \"[^\"]*\"/\"name\": \"@fortemate\\/dicechess-engine-wasm\"/" dist-wasm/package.json
rm dist-wasm/package.json.bak

# Copy assets to the distribution folder (sbt 2's shared target/out/ layout, not .wasm/target/)
cp target/out/sjs1/scala-3.*/dicechess-engine-wasm/dicechess-engine-wasm-opt/* dist-wasm/
cp js/dicechess-engine.d.ts dist-wasm/
cp js/README.md dist-wasm/README.md

# Compile optimized package.json for NPM publication (flattened paths, no 'files' field needed)
jq --arg ver "$CLEAN_VERSION" '
  .version = $ver |
  .name = "@fortemate/dicechess-engine-wasm" |
  .main = "main.js" |
  .types = "dicechess-engine.d.ts" |
  .exports["."].types = "./dicechess-engine.d.ts" |
  .exports["."].import = "./main.js" |
  .exports["."].default = "./main.js" |
  del(.files)
' package.json > dist-wasm/package.json
