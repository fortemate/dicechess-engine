#!/usr/bin/env bash
#MISE description="🔎 Verify npm tarballs and clean-project installation"

set -euo pipefail

TEMP_DIRECTORY=$(mktemp -d)
trap 'rm -rf -- "$TEMP_DIRECTORY"' EXIT

if [[ ${1:-} == "--bundle" ]]; then
  if [[ $# -ne 2 ]]; then
    echo "usage: $0 --bundle <bundle-directory>" >&2
    exit 2
  fi
  BUNDLE_DIRECTORY=$2
  RELEASE_TAG=$(jq -er '.release.tag' "$BUNDLE_DIRECTORY/manifest.json")
  COMMIT_SHA=$(jq -er '.release.sha' "$BUNDLE_DIRECTORY/manifest.json")
else
  if [[ $# -gt 2 ]]; then
    echo "usage: $0 [js-package-directory] [wasm-package-directory]" >&2
    exit 2
  fi
  JS_PACKAGE_DIRECTORY=${1:-dist}
  WASM_PACKAGE_DIRECTORY=${2:-dist-wasm}
  PACKAGE_VERSION=$(jq -er '.version' "$JS_PACKAGE_DIRECTORY/package.json")
  RELEASE_TAG="v$PACKAGE_VERSION"
  COMMIT_SHA=0000000000000000000000000000000000000000
  BUNDLE_DIRECTORY="$TEMP_DIRECTORY/bundle"
  bash "$(dirname "$0")/../../lib/create-npm-release-bundle.sh" \
    "$BUNDLE_DIRECTORY" \
    "$RELEASE_TAG" \
    "$COMMIT_SHA" \
    "$JS_PACKAGE_DIRECTORY" \
    "$WASM_PACKAGE_DIRECTORY"
fi

bash "$(dirname "$0")/../../lib/verify-npm-release-bundle.sh" \
  "$BUNDLE_DIRECTORY" \
  "$RELEASE_TAG" \
  "$COMMIT_SHA"

verify_package() {
  local expected_name=$1
  shift
  local expected_files=("$@")
  local actual_files="$TEMP_DIRECTORY/actual-files.txt"
  local expected_files_list="$TEMP_DIRECTORY/expected-files.txt"
  local filename
  local tarball

  filename=$(jq -er --arg name "$expected_name" '.packages[] | select(.name == $name) | .filename' "$BUNDLE_DIRECTORY/manifest.json")
  tarball="$BUNDLE_DIRECTORY/$filename"
  tar -tzf "$tarball" | sed -n 's#^package/##p' | sort >"$actual_files"
  printf '%s\n' "${expected_files[@]}" | sort >"$expected_files_list"
  diff -u "$expected_files_list" "$actual_files"

  local consumer="$TEMP_DIRECTORY/consumer-${expected_name##*/}"
  mkdir -p "$consumer"

  (cd "$consumer" && npm init --yes --scope=verification >/dev/null)
  npm install \
    --prefix "$consumer" \
    --ignore-scripts \
    --registry=https://registry.npmjs.org \
    "$tarball" >/dev/null

  (cd "$consumer" && node --input-type=module - \
    "$consumer/node_modules/$expected_name/package.json" \
    "$expected_name" \
    "${RELEASE_TAG#v}" <<'NODE'
import { readFile } from 'node:fs/promises';

const [, , manifestPath, expectedName, expectedVersion] = process.argv;
const manifest = JSON.parse(await readFile(manifestPath, 'utf8'));
if (manifest.name !== expectedName) {
  throw new Error(`installed ${manifest.name}, expected ${expectedName}`);
}
if (manifest.version !== expectedVersion) {
  throw new Error(`installed ${manifest.version}, expected ${expectedVersion}`);
}
if (manifest.repository?.url !== 'git+https://github.com/fortemate/dicechess-engine.git') {
  throw new Error(`unexpected repository URL for ${expectedName}`);
}
if (manifest.publishConfig?.registry !== undefined || manifest.publishConfig?.access !== 'public') {
  throw new Error(`unsafe publishConfig for ${expectedName}`);
}
await import(expectedName);
NODE
  )
}

verify_package \
  '@fortemate/dicechess-engine' \
  README.md \
  dicechess-engine.d.ts \
  dicechess-engine.js \
  package.json

verify_package \
  '@fortemate/dicechess-engine-wasm' \
  README.md \
  __loader.js \
  dicechess-engine.d.ts \
  main.js \
  main.wasm \
  main.wasm.map \
  package.json
